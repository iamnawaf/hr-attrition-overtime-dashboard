				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"Overtime", type text}, {"JobLevel", Int64.Type}, {"AttritionCount", Int64.Type}, {"AvgMonthlyIncome", type number}})
				in
